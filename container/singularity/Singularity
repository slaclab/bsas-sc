Bootstrap: docker
From: rockylinux:9

%labels
    Author "Claudio Bisegni"
    Version "1.0"
    Description "Singularity container for BSAS-SC EPICS application"

%help
    Singularity container for building and running the Beam Synchronous 
    Acquisition Service (BSAS-SC) application.
    
    Usage:
        # Build the image
        singularity build container/singularity/bsas-sc.sif container/singularity/Singularity
        
        # Run build inside container
        singularity exec -B "$(pwd):/work" container/singularity/bsas-sc.sif bash -c "cd /work && make configure && make -j"
        
        # Run with shell access
        singularity shell -B "$(pwd):/work" container/singularity/bsas-sc.sif

%environment
    export LANG=C.UTF-8
    export LC_ALL=C.UTF-8
    export PATH=/opt/epics/base/bin/linux-aarch64:$PATH
    export LD_LIBRARY_PATH=/opt/epics/base/lib/linux-aarch64:$LD_LIBRARY_PATH

%post
    # Update system packages
    dnf update -y
    
    # Install required build tools
    dnf install -y --allowerasing \
        gcc \
        gcc-c++ \
        make \
        automake \
        autoconf \
        git \
        wget \
        curl \
        tar \
        gzip \
        bzip2 \
        patch \
        perl \
        readline-devel \
        ncurses-devel \
        openssl-devel \
        zlib-devel
    
    # Install Python and tools for manager app
    dnf install -y \
        python3 \
        python3-devel \
        python3-pip
    
    # Enable EPEL and CRB (CodeReady Builder) for HDF5, ninja-build, and other packages
    dnf install -y epel-release
    dnf config-manager --enable crb

    # Install HDF5 development libraries
    dnf install -y \
        hdf5 \
        hdf5-devel
    
    # Install additional scientific/development packages
    dnf install -y \
        cmake \
        ninja-build \
        pkg-config \
        libxml2-devel \
        libicu-devel
    
    # Create installation directory structure
    mkdir -p /opt/epics
    mkdir -p /work
    
    # Clone and build EPICS Base 7.0.3.1 from SLAC fork
    cd /tmp
    git clone --depth 1 --branch R7.0.3.1 --recursive https://github.com/slac-epics/epics-base.git
    cd epics-base
    
    # Build EPICS base (uses Makefile, not autoconf)
    make -j $(nproc) INSTALL_LOCATION=/opt/epics/base

    # Some SLAC module RELEASE files expect legacy absolute paths.
    ln -sfn /opt/epics/base /base
    ln -sfn /opt/epics/modules /modules
    
    cd /
    rm -rf /tmp/epics-base
    
    # Install EPICS modules (SLAC forks with SLAC-specific version tags)
    mkdir -p /opt/epics/modules
    export GIT_TERMINAL_PROMPT=0
    
    # Install PVXS module
    cd /tmp
    rm -rf /tmp/pvxs
    git clone --depth 1 --branch R1.2.2-0.2.0 --recursive https://github.com/slac-epics/pvxs.git
    cd pvxs
    git submodule update --init --recursive
    make
    make INSTALL_LOCATION=/opt/epics/modules/pvxs/R1.2.2-0.2.0 install
    cd / && rm -rf /tmp/pvxs
    
    # Clean up DNF cache
    dnf clean all
    rm -rf /var/cache/dnf

%runscript
    exec "$@"

%startscript
    echo "BSAS-SC environment loaded"
    echo "Available commands:"
    echo "  - cd /work && make configure && make -j    # Build the project"
    echo "  - cd test && ./run-test.sh                  # Run tests"
    echo ""
    exec /bin/bash
